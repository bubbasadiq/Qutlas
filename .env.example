# Browser-side Supabase values. The publishable key is intended for client use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only Supabase values. Never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Optional Paystack payment integration. Orders remain unpaid when not configured.
PAYSTACK_SECRET_KEY=your-paystack-secret-key
NEXT_PUBLIC_SITE_URL=https://your-site.example

# Optional email draft recipients used by any legacy email-draft links.
NEXT_PUBLIC_QUOTE_EMAIL=support@qutlas.com
NEXT_PUBLIC_BUSINESS_EMAIL=hello@qutlas.com
